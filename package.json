    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "multer": "^1.4.5-lts.2",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
